__pycache__/
*.pyc
build/
dist/
*.spec
.DS_Store
Thumbs.db
fix.log

screenshots/
*.bak
*.orig

# 构建产物（fun build 生成，含本机绝对路径 → 隐私扫描会红）
# ⚠️ gitignore 不支持行尾注释（注释文本会成为 pattern 一部分）——注释必须单独成行。
#    下行依次是：.fsc/（09-28 起，新版 fun/fsc）、.fsc-lock.json、.fun/（09-28 前）、.fun-lock.json
.fsc/
.fsc-lock.json
.fun/
.fun-lock.json

# example/ 里不放工具副本（用仓库 toolchain/ 或全局 fun.exe / fui.exe；否则整包多 38MB 冗余）
**/example/fun.exe
**/example/ui/fui.exe

# 图标库生成物（可现场重建：components/icons/README.md §2/§6；
# out/.icons-cache/ 是按需解包缓存，同样不进库）
components/icons/out/

# 知识生长（P1）：日志/报告不进库；总账 inbox 走 PR（保留目录）
knowledge/_logs/
knowledge/_reports/

# 本地临时日志（跑门禁/用例时的抓屏输出，不入库）
temp_*.log

# 本机探测产物（构建探针，如 nanovg 可用性探测编出来的 .so；不是随包资产）
_nanovg_probe.so
_*_probe.so

# 会话验证产物（真机截图/二分样本/报告，可随时重建）
temp/
err.log

# ── IDE 本地状态 / 工具生成物（B6 出库）──────────────────────────────
# 判据：带**本机信息**或**工具重新生成**，入库即噪音——
#   language.settings.xml   → Eclipse CDT 的语言设置缓存，含本机 env-hash
#   org.eclipse.core.runtime.prefs → line.separator（本机行尾习惯）
#   .deps.lock              → fun install 解析出的版本锁（文件头自己写着「不适用于手动编辑」）
# **不要**把下面三件也删了（工程必需，已保留在库）：
#   .project / .cproject    → IDE 打开与编译必需（create_project 还要改里面的工程名）
#   .settings/com.zksw.flythings.easyui.prefs → 承载 resolution=（op 读它取分辨率）
#   .settings/org.eclipse.core.resources.prefs → encoding/<project>=UTF-8（中文注释保真）
language.settings.xml
org.eclipse.core.runtime.prefs
.deps.lock

# ── 编辑器 / 本机产物（一律不入库）──────────────────────────────────
# 判据：由编辑器或工具**生成**、与仓库内容无关。它们不只是噪音 ——
# 发布裁剪分支 `git rm` 目录时，这类**已跟踪**的隐藏文件会残留下来跟着发布包走
# （PUBLISH.md §6.1 踩过）。.DS_Store / Thumbs.db / *.pyc 已在上面忽略。
.vscode/
.idea/
*.iml
*.swp
*.swo
# fun/IDE 生成的编译数据库（.fsc/ 已被忽略，这里是防它跑到别处）
compile_commands.json
