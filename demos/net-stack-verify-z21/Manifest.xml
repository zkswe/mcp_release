<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE flythings>
<!--
  FlyThings 网络包验证（Z21 / SSD21X / 1024x600）—— 与 Z20 版同一套逻辑，平台差异按包站版本走：
    Z21: curl = 8.12.1-mbedtls / openssl = 1.1.1-g（Z20 是 1.1.1-w）/ mbedtls 3.6.5 / cares 1.17.2 / ntp 2.1.1
    ⚠️ mqtt-cxx 与 paho-mqtt3as 本地 registry 只有 Z20 版 → Z21 不验 MQTT（如实记「Z21 无此包」）
-->
<manifest platform="Z21">
    <dependencies enableOnPlatforms="Z21">
        <package id="easyui" version="2.2.0"/>
        <package id="log" version="0.0.0"/>
        <package id="base-utility" version="^10.8.5"/>

        <package id="curl-cxx" version="10.0.3"/>
        <package id="curl" version="8.12.1-mbedtls"/>
        <package id="mbedtls" version="3.6.5"/>
        <package id="cares" version="1.17.2"/>
        <package id="z" version="1.2.11"/>

        <package id="ntp" version="2.1.1"/>
        <package id="zknet" version="0.0.0"/>
    </dependencies>
</manifest>
