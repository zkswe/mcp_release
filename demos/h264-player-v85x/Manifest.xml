<?xml version="1.0" encoding="UTF-8"?>
<manifest cyclicDependency="true" platform="V85X">
    <!--
      ⚠️ 本 demo 用「本地库」形态（对应 knowledge/v85x/h264-player-usage.md 的路线 B）：
         include/  ← 从官方包 awh264player@1.0.0 的 include/ 拷进来
         lib-no-link/ ← 从同一个包的 lib/libawh264player.so 拷进来（只打包、不参与链接）
      这里**故意不声明** <package id="awh264player">：实测在 V85X 上直接声明该包，
      链接会因全志侧符号（CreateVideoDecoder/hw_display_init/hwd_layer_*，乃至 alsa 的 snd_*）无解析而失败
      （bin 工程带 -Wl,-z,defs）。要声明就得连 aw-mpp 一起，而 aw-mpp 又把 alsa 拉进来，v85x 无 alsa 包。
      详见 demo 的 README「为什么不去声明成依赖包」一节。
    -->
    <dependencies enableOnPlatforms="V85X"/>
</manifest>
