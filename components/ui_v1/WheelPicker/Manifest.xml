<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE flythings>

<!--
  WheelPicker（滚轮选择器）—— ui_v1 自定义控件包
  依赖：只用到 easyui 自带的 painter / textview（无第三方库）
-->
<manifest platform="Z21">
    <dependencies enableOnPlatforms="Z21,F133,F135,Z20,T113,V85X">
        <package id="easyui" version="^2.2.0"/>
        <package id="log" version="0.0.0"/>
        <package id="base-utility" version="^10.9.3"/>
    </dependencies>
</manifest>
