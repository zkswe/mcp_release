
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "process",
			"label": "构建项目",
			"command": "fun",
			"args": [
				"build"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": false 
			},
			"detail": "fun build",
			"problemMatcher": "$gcc",
		},
		{
			"type": "process",
			"label": "清理项目",
			"command": "fun",
			"args": [
				"clean"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"detail": "fun clean\n清理构建项目生成的中间文件"
		},
		{
			"type": "process",
			"label": "清理项目及依赖",
			"command": "fun",
			"args": [
				"clean",
				"--deps"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"detail": "fun clean --deps\n删除构建的中间文件及缓存的包信息"
		},
	]
}
