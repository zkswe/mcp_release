<?xml version="1.0" encoding="UTF-8"?>
<!--
  components/ble —— 包引用声明（Manifest 片段）

  用法（两种，二选一）：
  A) 源码引入（推荐先用这种，见 README「怎么把它接进工程」）
     把 components/ble 的 include/ 与 src/ 加进工程构建，编译即用；
     工程自己的 Manifest.xml 仍需按平台声明下面 **对应后端** 的底层依赖。
  B) 作为依赖包发布（模块定型后）
     把 components/ble 按平台编译成 include/lib，注册进包仓库，
     再在自己的 Manifest.xml 里写：<package id="zkble" version="0.2.0"></package>

  注意 1：版本必须锁死（btstack 的 HID/ATT 表按版本生成、gatt 是 BlueZ 用户态 ABI），不要用 ^ 浮动。
  注意 2：**同一平台只声明一个后端**（btstack 与 gatt 后端代码互斥，见 src/zkble_backend.h）。
  注意 3：本模块**不依赖 easyui / zknet / base-utility**（读系统属性直接走 /data/property，
          日志可经 setLogHook 挂到业务自己的日志系统）。别照抄老模板往里塞一堆没用的包。
-->
<manifest>

  <!-- ============================================================ btstack 后端（F133 / V85X） -->
  <platform name="F133">
    <dependencies>
      <package id="btstack" version="1.7.2"></package>   <!-- BLE 协议栈（BLE-only 构建）；唯一直接依赖 -->
    </dependencies>
  </platform>

  <platform name="V85X">
    <dependencies>
      <package id="btstack" version="1.8.0"></package>   <!-- V85X 的 btstack 比 F133 新（1.8.0） -->
    </dependencies>
  </platform>

  <!-- ============================================================ gatt 后端（Z20 / Z21 / T113 / T113EMMC） -->
  <!-- 只依赖 gatt 1.0.0（BlueZ 用户态 GATT 库）+ pthread；不需要 easyui/zknet/base-utility。
       运行期还要 hciconfig / hcitool 两个工具：产品化请放进升级包的 /res/bin；
       开发期可用本模块的工具路径候选链（/res/bin → /data/bin → /tmp/bin → /usr/bin → /bin）先跑。 -->
  <platform name="Z20">
    <dependencies>
      <package id="gatt" version="1.0.0"></package>
    </dependencies>
  </platform>

  <platform name="Z21">
    <dependencies>
      <package id="gatt" version="1.0.0"></package>
    </dependencies>
  </platform>

  <platform name="T113">
    <dependencies>
      <package id="gatt" version="1.0.0"></package>
    </dependencies>
  </platform>

  <platform name="T113EMMC">
    <dependencies>
      <package id="gatt" version="1.0.0"></package>
    </dependencies>
  </platform>

</manifest>
