{
  "_doc": "资产分类 + 判定参数登记表（供 tools/qa/alpha_bg_audit.py 与 tools/qa/corner_audit.py 共用）。",
  "_source": "口径出处：references/kb/image-gen-standard.md §7（透明底 / 圆角 / 平台差异）；阈值表见同文件 §7.4 与 tools/qa/README.md §5。",
  "_kinds": {
    "rect": "满盒圆角矩形族（磁贴/卡片/药丸/面板/按钮底）→ 必须有倒角；由 corner_audit 判圆角，alpha_bg_audit 只要求存在真透明区",
    "round": "内切圆/环族（圆钮/圆环/表盘）→ token = min(w,h)/2；角区必须透明",
    "inscribed": "内切形状族（滑块/开关滑块/非圆形内切图形）→ 形状外（角区）必须透明",
    "icon": "图标族（线框图标/信号图标/任意图形）→ 四周必须留 ≥1px 透明（§2.3）",
    "fullbleed": "满幅/底图族（照片、底图、遮罩、1px 通栏线、软阴影）→ 不要求形状外透明区（登记理由，见 allow_opaque）"
  },
  "defaults": {
    "alpha_opaque": 128,
    "min_alpha_max": 250,
    "zero_ratio_min": 0.002,
    "corner_block": 3,
    "corner_opaque_max": 0.5,
    "edge_bleed_max": 0.005,
    "corner_d_square": 1,
    "r_min_abs": 2.5,
    "radius_ratio_min": 0.5,
    "radius_ratio_warn": 0.8,
    "asym_max": 4.0,
    "asym_ratio": 0.5,
    "arc_lo_cov_max": 0.35,
    "arc_min_px": 8,
    "arc_corner_min_px": 4,
    "arc_lo_px_min": 2,
    "arc_bg_ratio": 0.0,
    "arc_bg_abs": 0,
    "arc_pad": 2,
    "arc_block_min": 6
  },
  "rules": [
    {"glob": "tile_*.png", "kind": "rect", "radius": 30, "note": "主屏磁贴 squircle（n=5, a=30；方形圆角图，见 DESIGN.md §6 圆角令牌）"},
    {"glob": "ct_card.9.png", "kind": "rect", "radius": 14, "ninepatch": true, "note": "9-patch 微描边卡片底（本体 r=14）；marker 环由 corner_audit 剥离、aa_audit 豁免；弧线过渡质量判据见标准 §7.7"},
    {"glob": "ct_card_*.9.png", "kind": "rect", "radius": 14, "ninepatch": true, "note": "M8 弧线过渡回归样本（反例/轻反例）；与真实资产 ct_card.9.png 同一判据路径"},
    {"glob": "card_*.9.png", "kind": "rect", "radius": 14, "ninepatch": true, "note": "M8 弧线过渡回归样本（合成正/反例：ss=4 / ss=1 硬画）；样本专用，真工程不要用 card_ 前缀"},
    {"glob": "ct_track.png", "kind": "rect", "radius": "pill",
     "note": "seekbar 轨道（令牌 track-on-dark #3C3C3E；294x24 == 控件盒）"},
    {"glob": "ct_fill.png", "kind": "rect", "radius": "pill"},
    {"glob": "ct_seg_*.png", "kind": "rect", "radius": "pill"},
    {"glob": "ct_thumb.png", "kind": "round",
     "note": "seekbar 滑块（24x24 圆，== 控件高；2026-09-20 M6 由 28x28 改小）"},
    {"glob": "ct_ring*.png", "kind": "round", "note": "circlebar 进度环 / 底环"},
    {"glob": "ct_dial.png", "kind": "round", "note": "pointer 表盘"},
    {"glob": "ct_needle.png", "kind": "icon", "note": "pointer 指针（任意图形，四周留白）"},
    {"glob": "ct_check_*.png", "kind": "icon", "note": "checkbox 皮肤：勾选框 24x24 画在 294x30 盒左侧，其余必须透明"},
    {"glob": "fan_*.png", "kind": "icon", "note": "WiFi 扇形信号图标"},
    {"glob": "sig_*.png", "kind": "icon", "note": "WiFi 信号图标（glyph_icon wifi）"},
    {"glob": "icon_*.png", "kind": "icon"},
    {"glob": "sw_*.png", "kind": "rect", "radius": "pill", "note": "iOS 开关（76x44 药丸）"},
    {"glob": "slider_*.png", "kind": "rect", "radius": "pill"},
    {"glob": "track_*.png", "kind": "rect", "radius": "pill"},
    {"glob": "fill_*.png", "kind": "rect", "radius": "pill"},
    {"glob": "vslider_*.png", "kind": "rect", "radius": "pill"},
    {"glob": "home_indicator.png", "kind": "rect", "radius": "pill"},
    {"glob": "battery.png", "kind": "rect", "radius": 7, "note": "电池图标：主体圆角矩形 r=7 + 右侧电极端头"},
    {"glob": "album_art.png", "kind": "rect", "radius": 24},
    {"glob": "album_thumb56.png", "kind": "rect", "radius": 12},
    {"glob": "album_thumb.png", "kind": "rect", "radius": 16},
    {"glob": "alert_panel.png", "kind": "rect", "radius": 24, "note": "弹窗面板"},
    {"glob": "card_white.png", "kind": "rect", "radius": 24},
    {"glob": "cc_panel.png", "kind": "rect", "radius": 34},
    {"glob": "cc_panel_*.png", "kind": "rect", "radius": 24, "note": "半透明面板（alpha<1，实测边起跑≈0）"},
    {"glob": "cc_tile.png", "kind": "rect", "radius": 26},
    {"glob": "cc_round_off*.png", "kind": "inscribed", "note": "关态圆钮（软边，边起跑不可测 → 只判角区透明）"},
    {"glob": "cc_round_on*.png", "kind": "round"},
    {"glob": "cc_round.png", "kind": "round"},
    {"glob": "chip.png", "kind": "rect", "radius": "pill"},
    {"glob": "dock.png", "kind": "rect", "radius": 44},
    {"glob": "player_row.png", "kind": "rect", "radius": 20},
    {"glob": "poster_big.png", "kind": "rect", "radius": 18},
    {"glob": "poster_dark.png", "kind": "rect", "radius": 18},
    {"glob": "calc_num_wide*.png", "kind": "rect", "radius": "pill", "note": "272x128 药丸（r=66≈h/2）"},
    {"glob": "calc_*.png", "kind": "round", "note": "计算器圆形键（128x128 圆）"},
    {"glob": "wallpaper.png", "kind": "fullbleed", "reason": "整屏壁纸底图（必须不透明：它是页面最底层）"},
    {"glob": "grad_Wallpaper_0.png", "kind": "fullbleed", "reason": "整屏渐变壁纸底图（同上）"},
    {"glob": "album_p*.png", "kind": "fullbleed", "reason": "相册照片内容图（照片本体不透明，透明度由控件层承担）"},
    {"glob": "card_sep.png", "kind": "fullbleed", "reason": "1px 通栏分隔线（发丝线口径 §1.4：轴对齐线保持不透明）"},
    {"glob": "sep.png", "kind": "fullbleed", "reason": "1px 通栏分隔线（同上）"},
    {"glob": "sep_dark.png", "kind": "fullbleed", "reason": "1px 通栏分隔线（同上）"},
    {"glob": "cc_scrim.png", "kind": "fullbleed", "reason": "全屏遮罩层（满幅半透明层；形状外没有「外面」）"},
    {"glob": "shadow_*.png", "kind": "fullbleed", "reason": "软阴影图（形状外就是阴影自身的渐隐翼，不是烘底）"}
  ],
  "unknown_policy": "未登记资产：两个工具都只出 NOTE（列出、不判 FAIL、不静默）→ 需在设计标准 §7.1 的分类表里补一条登记。"
}
