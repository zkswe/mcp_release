{
  "schemaVersion": "1.0",
  "updated": "2026-10-02",
  "authority": "FlyThings UI json 布局规范的唯一机器可读真源。字段/类型/必填/默认值以本表为准；knowledge/*.md 只负责原理、流程与行为。基准：json-field-mandatory.md v2.1（SampleUI-New 42json + basedemo 44json 双源）+ V85X 真机 A/B 实测（2026-10-02）。消费方：check_all 校验 / translate_ui 发射层 / map_control 片段 / gen_ui_schema_docs.py 文档表。改规范 = 改本文件，禁止在消费方另抄一份。",
  "valueRules": {
    "colorMinusOne": "-1 = 0xFFFFFFFF 是有意义的显式值（透明/未用），非噪音，必须显式写",
    "colorZero": "0 = 不透明黑。仅 videoview/cameraview 底色官方原值为 0（必须实黑底）；其他控件透明写 -1，写 0 就是黑块（M6 实测坑）",
    "missingImage": "图片字段指向不存在文件或置 '' → 控件不可见（framework 容错，不挂死），属验收缺陷",
    "subboxType": "⛔ 子盒对象字段（thumb/position/colorTab/picTab/size/point/range）写成字符串或其他类型 = 真机 ftu 加载无声挂死（无 onUI_init/onUI_show、无报错日志）。A/B 实测 V85X iMirror 固件 2026-10-02：thumb 对象+缺图=正常，thumb 字符串+有图=挂死",
    "fullFields": "生成 json 时每控件输出本类型必填字段全集（含默认值），不做缺省声明——不同 fui/easyui 版本默认处理可能不同（沛哥 2026-09-08）"
  },
  "page": {
    "controlKeyPattern": "^[a-z]+__\\d+$",
    "nesting": "window 类容器内嵌子控件（key 同为 <type>__N）；子控件 position 是父相对坐标，屏幕坐标 = 累加父偏移",
    "rootFields": {
      "id": {"type": "int", "required": true, "default": 0},
      "resolution": {"type": "resolution", "required": true},
      "position": {"type": "position", "required": true, "note": "整页通常 left0/top0/width=resolution.width/height=resolution.height"},
      "backgroundColor": {"type": "color", "required": true, "default": -1},
      "topmost": {"type": "bool", "required": false, "default": false},
      "beepEnable": {"type": "bool", "required": false, "note": "不强制（沛哥 2026-09-08，两源证实非必写）"}
    }
  },
  "sharedTypes": {
    "position": {"shape": "object", "fields": {"left": "int", "top": "int", "width": "int", "height": "int"}},
    "resolution": {"shape": "object", "fields": {"width": "int", "height": "int"}},
    "size": {"shape": "object", "fields": {"width": "int", "height": "int"}},
    "point": {"shape": "object", "fields": {"x": "int", "y": "int"}},
    "range": {"shape": "object", "fields": {"lower": "int", "upper": "int"}},
    "colorTab": {"shape": "object", "fields": {"color0": "color", "color1": "color", "color2": "color", "color3": "color", "color4": "color"}, "defaults": {"color1": -1, "color2": -1, "color3": -1, "color4": -1}, "note": "五槽色表，未用槽恒 -1"},
    "picTab": {"shape": "object", "fields": {"pic0": "path", "pic1": "path", "pic2": "path", "pic3": "path", "pic4": "path"}, "note": "多态图：pic0 正常/pic1 按下/pic2 选中/pic3 选中按下/pic4 无效；键可不全、值 '' = 无图；{} 合法"},
    "thumb": {"shape": "object", "fields": {"size": "size", "normalPic": "path", "pressedPic": "path"}, "requiredKeys": ["size", "normalPic", "pressedPic"], "fatal": "写成字符串 = ftu 加载无声挂死（A/B 实测 2026-10-02）；无图 = size 置 0 + 两 Pic 置 ''"},
    "iconBox": {"shape": "object", "fields": {"left": "int", "top": "int", "width": "int", "height": "int"}, "note": "iconPosition/textPosition 用，条件写（有图标/图文混排设计时）"}
  },
  "controls": {
