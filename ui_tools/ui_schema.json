{
  "schemaVersion": "1.1",
  "updated": "2026-10-04",
  "authority": "FlyThings UI json 布局规范的唯一机器可读真源。字段/类型/必填/默认值以本表为准；knowledge/*.md 只负责原理、流程与行为。基准：json-field-mandatory.md v2.1（SampleUI-New 42json + basedemo 44json 双源）+ V85X 真机 A/B 实测（2026-10-02 / 2026-10-04）。v1.1（2026-10-04）：circlebar.progressPicPos 由 int 改 position、touchRange 由 int 改 range —— 误声明成 int 时 defaults() 会发射 0，真机上页面构造即主线程 100% 空转、无日志（同 subboxType 那一类，只是类型声明错了导致校验漏网）。消费方：check_all 校验 / translate_ui 发射层 / map_control 片段 / gen_ui_schema_docs.py 文档表。改规范 = 改本文件，禁止在消费方另抄一份。",
  "logicCallbacksNote": "每控件可生成的回调桩（v0.27.178）。{Caption} = json 里控件 key 的 __ 后缀。来源：35 官方 Demo 源码逐条取证（knowledge/uicontrols/widget-code-api.md 是其讲解）；op flythings_gen_logic_stub 从这里读——不要在别处另写一份回调名表。listview 的 3 条是一组，缺一列表就是空白。",
  "valueRules": {
    "colorMinusOne": "-1 = 0xFFFFFFFF 是有意义的显式值（透明/未用），非噪音，必须显式写",
    "colorZero": "0 = 不透明黑。仅 videoview/cameraview 底色官方原值为 0（必须实黑底）；其他控件透明写 -1，写 0 就是黑块（M6 实测坑）",
    "missingImage": "图片字段**指向不存在的文件** → 该图不显示（框架容错、不挂死）；`\"\"` = 不设该图，**不影响控件可见性**",
    "subboxType": "⛔ 子盒对象字段（thumb/position/colorTab/picTab/bgColorTab/iconPosition/textPosition/iconBox/size/point/range 等）写成字符串或其他类型 = 真机 ftu 加载无声挂死（无 onUI_init/onUI_show、无报错日志）。A/B 实测 V85X iMirror 固件 2026-10-02：thumb 对象+缺图=正常，thumb 字符串+有图=挂死",
    "fullFields": "生成 json 时每控件输出本类型必填字段全集（含默认值），不做缺省声明——不同 fui/easyui 版本默认处理可能不同（2026-09-08）",
    "zOrderFollowsJsonOrder": "**json 里控件的书写顺序 = 图层顺序**（后写的盖在前面）。用 `sort_keys=True` 之类整体重排会改变层叠（例：全屏铺底层被排到进度条之上 → 控件看不见）",
    "textNewlineNotSupported": "**控件文本里不产生换行**：源文本的换行/空白折叠成单个空格；写 `\\n` 会被按**整串**算最小尺寸，触发 `check_all` 第 13 项（最小尺寸）判定。要多行文案 → 拆成多个控件",
    "setInvalidIsDisable": "`setInvalid(true)` 是**禁用**（不响应触摸），**不是**\"强制重绘\"；要重绘用 `invalidate()`（2026-09-17 真机复核）",
    "callbackStubRequired": "**桩禁手写；`<p>Logic.cc` 禁删除（有业务代码时）**：每个控件 `callbacks` 的名字要有同名 static 函数（`<回调名>_<caption>`），否则 `fun build` 报 `used but never defined`。**缺桩时**：让 `fun build` 先跑（工具链会把桩追加进该文件），**再把追加的桩移到文件作用域**（顶层，与参考工程 `controlsLogic.cc` 一致）——**非破坏**操作。⚠️ **`rm <p>Logic.cc` + 重建只允许用于首次构建/文件里尚无业务代码的场合**；**一旦有业务代码，删除重建 = 代码衰退，禁止**（本表 `callbacks[].stub` 只作形状参考，别粘）。",
    "twoBuildPaths": "**Activity 的差异只在构建层，业务代码不分叉**（用户口径 2026-10-04）：fun 路径不生成 `<p>Activity.*`、IDE 路径会生成 —— 但**业务代码一律照常写** `EASYUICONTEXT->openActivity(\"<p>Activity\")` 跳转、`EASYUICONTEXT->goBack()` 返回，不因构建方式而改变。"
  },
  "page": {
    "controlKeyPattern": "^[a-z]+__\\d+$",
    "nesting": "window 类容器内嵌子控件（key 同为 <type>__N）；子控件 position 是父相对坐标，屏幕坐标 = 累加父偏移",
    "rootFields": {
      "id": {
        "type": "int",
        "required": true,
        "default": 0
      },
      "resolution": {
        "type": "resolution",
        "required": true
      },
      "position": {
        "type": "position",
        "required": true,
        "note": "整页通常 left0/top0/width=resolution.width/height=resolution.height"
      },
      "backgroundColor": {
        "type": "color",
        "required": true,
        "default": -1
      },
      "topmost": {
        "type": "bool",
        "required": false,
        "default": false
      },
      "beepEnable": {
        "type": "bool",
        "required": false,
        "note": "不强制（2026-09-08，两源证实非必写）"
      }
    }
  },
