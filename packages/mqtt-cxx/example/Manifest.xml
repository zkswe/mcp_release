<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE flythings>
<!--
  mqtt-cxx 3.2.0 最小示例（Z20 86 面板 / 480x480）
  ⚠️ TLS（mqtts）场景必须连带声明 paho-mqtt3as + openssl：
     paho-mqtt3as 的二进制引用 BIO_read/RAND_bytes/SHA1_* → 漏 openssl 会在链接阶段炸。
  ⚠️ Z20 registry 里没有 paho-mqtt3a（只有 paho-mqtt3as）→ 这里就用 as 版。
  改完 Manifest 必须 fsc install（否则头文件/库路径不进 CMake）。
-->
<manifest platform="Z20">
    <dependencies enableOnPlatforms="Z20">
        <package id="easyui" version="^2.2.0"/>
        <package id="log" version="0.0.0"/>
        <package id="base-utility" version="^10.8.5"/>

        <package id="mqtt-cxx" version="3.2.0"/>
        <package id="paho-mqtt3as" version="1.3.13"/>
        <package id="openssl" version="1.1.1-w"/>
        <package id="z" version="1.2.11"/>
    </dependencies>
</manifest>
