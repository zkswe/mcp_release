{
  "_doc": "示例 H · 320×240（边界屏）：与 ../complex_1024x600/spec.json 是**同一份块清单**（第 4 批 7 个新块全都用上），只换 resolution + 极小屏短文案（行族整页降单行式、字号降 2 级、chart 刻度用短文案、相册 3 列 2 行、键盘 3 列 4 行）。不给 page.title —— 标题带由 toolbar 承担。",
  "resolution": {
    "width": 320,
    "height": 240
  },
  "page": {
    "blocks": [
      {
        "type": "toolbar",
        "title": "设备",
        "back": true,
        "actions": [{"icon": "refresh"}, {"icon": "settings"}]
      },
      {
        "type": "chart_card",
        "kind": "bar",
        "title": "近 7 日用电",
        "data": [12, 18, 9, 24, 15, 21, 11],
        "labels": ["一", "二", "三", "四", "五", "六", "日"],
        "note": "单位 kWh"
      },
      {
        "type": "chart_card",
        "kind": "line",
        "title": "室内温度",
        "data": [21, 23, 22, 25, 24, 26],
        "labels": ["8", "10", "12", "14", "16", "18"],
        "note": "单位 摄氏度"
      },
      {
        "type": "card",
        "title": "信息",
        "blocks": [
          {"type": "setting_row", "label": "名称", "value": "客厅面板", "value_short": "客厅"},
          {"type": "time_row", "label": "同步", "value": "2026-10-01 20:20", "value_short": "20:20"},
          {"type": "setting_row", "label": "位置", "value": "一层客厅", "value_short": "客厅"}
        ]
      },
      {
        "type": "form_section",
        "title": "联网",
        "surface": false,
        "blocks": [
          {"type": "input_row", "label": "WiFi", "hintText": "名称", "text": "IOT", "textType": 0},
          {"type": "checkbox_row", "label": "重连", "value": "已勾选", "value_short": "已勾", "checked": true},
          {"type": "toggle_row", "label": "图标", "value": "已开", "on": true}
        ]
      },
      {
        "type": "image_gallery",
        "title": "相册",
        "count": 12,
        "countText": "12 张",
        "cols": 3,
        "rows": 2,
        "tappable": true
      },
      {
        "type": "loading",
        "variant": "skeleton",
        "text": "同步中...",
        "lines": 3
      },
      {
        "type": "keypad",
        "display": "12.5"
      },
      {
        "type": "loading",
        "variant": "spinner",
        "text": "连接中..."
      },
      {
        "type": "bottom_actions",
        "primary": "保存",
        "secondary": "取消"
      }
    ]
  }
}
